#include <EEPROM.h>

#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <Adafruit_Fingerprint.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);
#define sw1 3
#define sw2 4
#define sw3 5
#define sw4 6
#define sw5 7
#define resultButton 8 // Define a new button for displaying results

int vote1 = 0;
int vote2 = 0;
int vote3 = 0;
int vote4 = 0;

int id = 0;

#define records 50 // You can adjust the value based on your requirements

Adafruit_Fingerprint finger = Adafruit_Fingerprint(&Serial);

void setup()
{
  lcd.init();
  lcd.backlight();
  pinMode(sw1, INPUT);
  pinMode(sw2, INPUT);
  pinMode(sw3, INPUT);
  pinMode(sw4, INPUT);
  pinMode(sw5, INPUT);
  pinMode(resultButton, INPUT_PULLUP); // Use INPUT_PULLUP to enable internal pull-up resistor
  pinMode(13, OUTPUT);
  pinMode(12, OUTPUT);
  pinMode(11, OUTPUT);
  pinMode(10, OUTPUT);

  lcd.begin(16, 2);
  lcd.setCursor(0, 0);
  lcd.print("VOTING AND ENROLL");
  lcd.setCursor(0, 1);
  lcd.print("MACHINE");

  digitalWrite(sw1, HIGH);
  digitalWrite(sw2, HIGH);
  digitalWrite(sw3, HIGH);
  digitalWrite(sw4, HIGH);
  digitalWrite(sw5, HIGH);
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("BJP");
  lcd.setCursor(4, 0);
  lcd.print("INC");
  lcd.setCursor(8, 0);
  lcd.print("AAP");
  lcd.setCursor(12, 0);
  lcd.print("OTH");

  Serial.begin(57600);
  finger.begin(57600);
}

void loop()
{
  lcd.setCursor(0, 0);
  lcd.print("BJP");
  lcd.setCursor(1, 1);
  lcd.print(vote1);
  lcd.setCursor(4, 0);
  lcd.print("INC");
  lcd.setCursor(5, 1);
  lcd.print(vote2);
  lcd.setCursor(8, 0);
  lcd.print("AAP");
  lcd.setCursor(9, 1);
  lcd.print(vote3);
  lcd.setCursor(12, 0);
  lcd.print("OTH");
  lcd.setCursor(13, 1);
  lcd.print(vote4);

  if (digitalRead(sw1) == 0)
  {
    vote1++;
    while (digitalRead(sw1) == 0)
      ;
    digitalWrite(13, HIGH);
    delay(300);
    digitalWrite(13, LOW);
  }

  if (digitalRead(sw2) == 0)
  {
    vote2++;
    while (digitalRead(sw2) == 0)
      ;
    digitalWrite(13, HIGH);
    delay(300);
    digitalWrite(13, LOW);
  }

  if (digitalRead(sw3) == 0)
  {
    vote3++;
    while (digitalRead(sw3) == 0)
      ;
    digitalWrite(13, HIGH);
    delay(300);
    digitalWrite(13, LOW);
  }

  if (digitalRead(sw4) == 0)
  {
    vote4++;
    while (digitalRead(sw4) == 0)
      ;
    digitalWrite(13, HIGH);
    delay(300);
    digitalWrite(13, LOW);
  }

  if (digitalRead(sw5) == 0)
  {
    digitalWrite(12, HIGH);
    int vote = vote1 + vote2 + vote3 + vote4;
    if (vote)
    {
      if ((vote1 > vote2 && vote1 > vote3 && vote1 > vote4))
      {
        lcd.clear();
        lcd.print("BJP Wins");
        delay(1000);
        digitalWrite(12, LOW);
        lcd.clear();
      }
      else if ((vote2 > vote1 && vote2 > vote3 && vote2 > vote4))
      {
        lcd.clear();
        lcd.print("INC Wins");
        delay(1000);
        digitalWrite(12, LOW);
        lcd.clear();
      }
      else if ((vote3 > vote1 && vote3 > vote2 && vote3 > vote4))
      {
        lcd.clear();
        lcd.print("AAP Wins");
        delay(1000);
        digitalWrite(12, LOW);
        lcd.clear();
      }
      else if (vote4 > vote1 && vote4 > vote2 && vote4 > vote3)
      {
        lcd.setCursor(0, 0);
        lcd.clear();
        lcd.print("OTH Wins");
        delay(1000);
        digitalWrite(12, LOW);
        lcd.clear();
      }
      else
      {
        lcd.clear();
        lcd.print("   Tie Up Or   ");
        lcd.setCursor(0, 1);
        lcd.print("   No Result   ");
        delay(1000);
        digitalWrite(12, LOW);
        lcd.clear();
      }
    }
    else
    {
      lcd.clear();
      lcd.print("No Voting....");
      delay(1000);
      digitalWrite(12, LOW);
      lcd.clear();
    }
    vote1 = 0;
    vote2 = 0;
    vote3 = 0;
    vote4 = 0, vote = 0;
    lcd.clear();
  }

  // Fingerprint enrollment logic
  if (digitalRead(sw5) == 0)
  {
    Enroll();
  }

  // Display result button
  if (digitalRead(resultButton) == LOW)
  {
    DisplayResult();
    delay(1000); // Debounce delay
  }
}

void Enroll()
{
  int count = 0;

  lcd.clear();
  lcd.print("Enter Finger ID:");

  while (1)
  {
    lcd.setCursor(0, 1);
    lcd.print(count);

    if (digitalRead(sw1) == 0)
    {
      count++;
      if (count > 25)
        count = 0;
      delay(500);
    }
    else if (digitalRead(sw2) == 0)
    {
      count--;
      if (count < 0)
        count = 25;
      delay(500);
    }
    else if (digitalRead(sw3) == 0)
    {
      id = count;
      uint8_t result = getFingerprintEnroll();
      for (int i = 0; i < records; i++)
      {
        if (EEPROM.read(i + 10) == 0xff)
        {
          EEPROM.write(i + 10, id);
          break;
        }
      }
      return;
    }
    else if (digitalRead(sw4) == 0)
    {
      return;
    }
  }
}

void DisplayResult()
{
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Result:");
  
  // Display voting results
  lcd.setCursor(0, 1);
  lcd.print("BJP: ");
  lcd.print(vote1);
  lcd.print("  INC: ");
  lcd.print(vote2);
  lcd.print("  AAP: ");
  lcd.print(vote3);
  lcd.print("  OTH: ");
  lcd.print(vote4);
  
  delay(5000); // Display results for 5 seconds
  lcd.clear();
}

uint8_t getFingerprintEnroll()
{
  int p = -1;

  lcd.clear();
  lcd.print("finger ID:");
  lcd.print(id);
  lcd.setCursor(0, 1);
  lcd.print("Place Finger");
  delay(2000);

  while (p != FINGERPRINT_OK)
  {
    p = finger.getImage();
    switch (p)
    {
    case FINGERPRINT_OK:
      lcd.clear();
      lcd.print("Image taken");
      break;
    case FINGERPRINT_NOFINGER:
      lcd.clear();
      lcd.print("No Finger");
      break;
    case FINGERPRINT_PACKETRECIEVEERR:
      lcd.clear();
      lcd.print("Communication err");
      break;
    case FINGERPRINT_IMAGEFAIL:
      lcd.clear();
      lcd.print("Imaging fail");
      break;
    default:
      lcd.clear();
      lcd.print("Unknown error");
      break;
    }
  }

  p = finger.image2Tz(1);
  switch (p)
  {
  case FINGERPRINT_OK:
    lcd.clear();
    lcd.print("Image converted");
    break;
  case FINGERPRINT_IMAGEMESS:
    lcd.clear();
    lcd.print("Image too messy");
    return p;
  case FINGERPRINT_PACKETRECIEVEERR:
    lcd.clear();
    lcd.print("Communication err");
    return p;
  case FINGERPRINT_FEATUREFAIL:
    lcd.clear();
    lcd.print("Could not find fingerprint features");
    return p;
  case FINGERPRINT_INVALIDIMAGE:
    lcd.clear();
    lcd.print("Could not find fingerprint features");
    return p;
  default:
    lcd.clear();
    lcd.print("Unknown error");
    return p;
  }

  lcd.clear();
  lcd.print("Remove finger");
  delay(2000);
  p = 0;
  while (p != FINGERPRINT_NOFINGER)
  {
    p = finger.getImage();
  }

  lcd.clear();
  lcd.print("Place same finger again");
  delay(2000);

  p = -1;
  while (p != FINGERPRINT_OK)
  {
    p = finger.getImage();
    switch (p)
    {
    case FINGERPRINT_OK:
      lcd.clear();
      lcd.print("Image taken");
      break;
    case FINGERPRINT_NOFINGER:
      lcd.clear();
      lcd.print("No Finger");
      break;
    case FINGERPRINT_PACKETRECIEVEERR:
      lcd.clear();
      lcd.print("Communication err");
      break;
    case FINGERPRINT_IMAGEFAIL:
      lcd.clear();
      lcd.print("Imaging fail");
      break;
    default:
      lcd.clear();
      lcd.print("Unknown error");
      break;
    }
  }

  p = finger.image2Tz(2);
  switch (p)
  {
  case FINGERPRINT_OK:
    lcd.clear();
    lcd.print("Image converted");
    break;
  case FINGERPRINT_IMAGEMESS:
    lcd.clear();
    lcd.print("Image too messy");
    return p;
  case FINGERPRINT_PACKETRECIEVEERR:
    lcd.clear();
    lcd.print("Communication err");
    return p;
  case FINGERPRINT_FEATUREFAIL:
    lcd.clear();
    lcd.print("Could not find fingerprint features");
    return p;
  case FINGERPRINT_INVALIDIMAGE:
    lcd.clear();
    lcd.print("Could not find fingerprint features");
    return p;
  default:
    lcd.clear();
    lcd.print("Unknown error");
    return p;
  }

  p = finger.createModel();
  switch (p)
  {
  case FINGERPRINT_OK:
    lcd.clear();
    lcd.print("Prints matched");
    break;
  case FINGERPRINT_PACKETRECIEVEERR:
    lcd.clear();
    lcd.print("Communication err");
    return p;
  case FINGERPRINT_ENROLLMISMATCH:
    lcd.clear();
    lcd.print("Fingerprints did not match");
    return p;
  default:
    lcd.clear();
    lcd.print("Unknown error");
    return p;
  }

  p = finger.storeModel(id);
  switch (p)
  {
  case FINGERPRINT_OK:
    lcd.clear();
    lcd.print("Stored");
    break;
  case FINGERPRINT_PACKETRECIEVEERR:
    lcd.clear();
    lcd.print("Communication err");
    return p;
  case FINGERPRINT_BADLOCATION:
    lcd.clear();
    lcd.print("Could not store in that location");
    return p;
  case FINGERPRINT_FLASHERR:
    lcd.clear();
    lcd.print("Error writing to flash");
    return p;
  default:
    lcd.clear();
    lcd.print("Unknown error");
    return p;
  }
}
